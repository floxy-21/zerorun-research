+    def p_pragma_list(self, p):
+        """ pragma_list : pppragma_directive
+                        | pragma_list pppragma_directive
+        """
+        p[0] = [p[1]] if len(p) == 2 else p[1] + [p[2]]
+
+    def p_pragmacomp_or_statement(self, p):
+        """ pragmacomp_or_statement : statement
+                                    | pragma_list statement
+        """
+        # A pragma does not consume the statement required by a control-flow
+        # construct or label. Preserve both in a synthetic compound body.
+        if len(p) == 2:
+            p[0] = p[1]
+        else:
+            p[0] = c_ast.Compound(p[1] + [p[2]], p[1][0].coord)
